# OralAI Flask Backend — Environment Variables
# Copy this file to .env:   copy .env.example .env
# Then edit values as needed.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=0
SECRET_KEY=change-me-use-a-long-random-string

# ── CORS ─────────────────────────────────────────────────────────────────────
# Frontend URL(s). Separate multiple with commas.
# Must match exactly what the browser sends as the Origin header.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── AI Model ─────────────────────────────────────────────────────────────────
# Path to trained TensorFlow model (.h5). Leave as-is if not using real CNN.
MODEL_PATH=model/oral_cnn.h5
IMG_SIZE=224

# ── Demo / Mock Mode ─────────────────────────────────────────────────────────
# DEMO_MODE=1  → use random mock predictions (default, no model needed)
# DEMO_MODE=0  → require a real model; returns 503 if not loaded
DEMO_MODE=1

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=20
MAX_SCANS=100

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── SMS / OTP (Twilio) ───────────────────────────────────────────────────────
# Sign up free at https://www.twilio.com  →  get Account SID, Auth Token, and
# a trial phone number from Console → Phone Numbers → Manage → Active Numbers.
# Leave blank to run without SMS (demo mode — OTP printed to server log only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX

# OTP validity window in seconds (default 10 minutes)
OTP_EXPIRY_SECONDS=600
